# Supabase. Locally, `supabase start` prints both (API URL and Publishable key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "devnet" (local and previews) or "mainnet" (production only). Defaults to devnet.
# Anything but mainnet shows a DEVNET badge on every page.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional. Defaults to the cluster's public endpoint, which is rate-limited.
NEXT_PUBLIC_SOLANA_RPC_URL=

# "mock" (default) runs the app against an in-browser mock of the proof service,
# so the screens work without the Rust service. "real" calls it and needs the URL.
# Mock mode is refused on mainnet.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_PROOF_API_URL=
