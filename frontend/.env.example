# Supabase. Locally, `supabase start` prints both (API URL and Publishable key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The origin the emailed sign-in link points at, e.g. https://app.cadence.example. Never
# taken from the request, so a forged Origin or forwarded host cannot redirect the link.
# Required in a production build with Supabase configured (the build fails without it),
# and https unless it is localhost. Unset under `next dev`: the request's Origin is used.
# The Supabase Auth redirect URLs must list <this origin>/auth/confirm exactly.
NEXT_PUBLIC_SITE_URL=

# "devnet" (local and previews) or "mainnet" (production only). Defaults to devnet under
# `next dev` and in tests; a production build (`pnpm build`, a deploy) must set it.
# Anything but mainnet shows a DEVNET badge on every page.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional. Defaults to the cluster's public endpoint, which is rate-limited.
NEXT_PUBLIC_SOLANA_RPC_URL=

# "mock" runs the app against an in-browser mock of the proof service, so the
# screens work without the Rust service, and shows a MOCK DATA badge. "real"
# calls it, needs the URL, and the URL must be https (http only for localhost).
# `next dev` defaults to mock; any other environment (build, preview, production)
# must set this, or the app refuses to start. Mock mode is refused on mainnet.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_PROOF_API_URL=

# The /dev pages (component showcase, screen previews, API playground) show fake data
# and need no session. `next dev` serves them; a production build answers 404 unless
# this is 1. Set it on a preview that needs them, never on production. Mainnet always
# answers 404.
NEXT_PUBLIC_DEV_TOOLS=
